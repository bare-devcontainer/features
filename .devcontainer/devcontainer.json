{
  "name": "Debian",
  "image": "ghcr.io/bare-devcontainer/debian:trixie-20260810@sha256:baee21808301490b53183cfef50a4f13f0b026f18ab3adc440572983307ad956",
  "features": {
    "ghcr.io/bare-devcontainer/features/claude-code:1.1.0": {}
  },
  "runArgs": [
    "--cap-drop=ALL"
  ],
  // Remove "no-new-privileges" if users need to gain elevated privileges inside the container (e.g., su, sudo).
  "securityOpt": [
    "no-new-privileges"
  ],
  "remoteUser": "dev",
  "init": true,
  "remoteEnv": {
    "EDITOR": "code --wait",
    "VISUAL": "code --wait"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // renovate: datasource=github-tags depName=anthropics/claude-code
        "anthropic.claude-code@2.1.237",
        // renovate: datasource=github-tags depName=editorconfig/editorconfig-vscode
        "EditorConfig.EditorConfig@0.18.2"
      ],
      "settings": {
        "json.schemaDownload.trustedDomains": {
          "https://schemastore.azurewebsites.net/": true,
          "https://raw.githubusercontent.com/microsoft/vscode/": true,
          "https://raw.githubusercontent.com/devcontainers/spec/": true,
          "https://www.schemastore.org/": true,
          "https://json.schemastore.org/": true,
          "https://json-schema.org/": true,
          "https://developer.microsoft.com/json-schemas/": true,
          "https://docs.renovatebot.com/": true
        }
      }
    }
  }
}
